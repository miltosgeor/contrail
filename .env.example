# Copy to .env and adjust. .env is gitignored -- never commit real values.

# Where Contrail stores traces.
CONTRAIL_DB=contrail.db

# --- Point Claude Code at the collector -----------------------------------
# Source these in the shell where you run Claude Code, not here.
#
#   export CLAUDE_CODE_ENABLE_TELEMETRY=1
#   export CLAUDE_CODE_ENHANCED_TELEMETRY_BETA=1   # traces are still beta
#   export OTEL_TRACES_EXPORTER=otlp
#   export OTEL_METRICS_EXPORTER=otlp
#   export OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
#   export OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
#   export OTEL_TRACES_EXPORT_INTERVAL=1000        # flush fast while developing
#
# Optional, and off by default because they capture content:
#   export OTEL_LOG_TOOL_DETAILS=1                 # tool input arguments
#   export OTEL_LOG_USER_PROMPTS=1                 # prompt text
